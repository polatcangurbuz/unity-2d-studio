<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the Unity EditMode tests on plain .NET: same sources, no Unity install needed. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Match3.Tests</AssemblyName>
    <RootNamespace>__NS__.Puzzle.Tests</RootNamespace>
    <!-- dotnet build -p:UnityNUnit=true compiles against Unity's NUnit 3.5 API (catches asserts Unity lacks); it can't run there. -->
    <NUnitVersion Condition="'$(UnityNUnit)' == 'true'">3.5.0</NUnitVersion>
    <NUnitVersion Condition="'$(NUnitVersion)' == ''">3.14.0</NUnitVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Runtime/**/*.cs" />
    <Compile Include="../Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="$(NUnitVersion)" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
